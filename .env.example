# Copy this file to .env and adjust. .env is git-ignored; this file is committed.

# Port the Streamlit app listens on (never use 5000: reserved by AirDrop on macOS)
APP_PORT=8601
# Address the app binds to and prints in its URL (keep localhost: the app is local only)
APP_HOST=localhost
# Command used by scripts/start.sh (single quotes keep $APP_PORT and $APP_HOST unexpanded until launch)
APP_START_CMD='.venv/bin/python -m streamlit run app.py --server.port $APP_PORT --server.address $APP_HOST --server.headless true --browser.gatherUsageStats false'
# Compute device: auto | cpu | mps | cuda
DEVICE=auto
# Default random seed used by demos and training
DEFAULT_SEED=42
# Folder with optional .txt/.md training files (read recursively)
INPUT_DIR=input
# Folder for checkpoints and metrics (timestamped file names)
OUTPUT_DIR=output

# --- Animated GIF generator (scripts/generate-animations.sh) ---
# Folder for the GIFs and their index.html gallery (relative to the project root)
ANIM_OUTPUT_DIR=Docs/subtasks/animations
# Pixel size of every GIF (480x270 to 1920x1920; 800x450 keeps files small)
ANIM_WIDTH=800
ANIM_HEIGHT=450
# Milliseconds per tween frame (60 is about 16 frames per second)
ANIM_FRAME_MS=60
# Training steps behind the training and inference GIFs (fewer = faster, noisier text)
ANIM_TRAIN_STEPS=300
# The sentence that travels through the animations
ANIM_PHRASE=The robot read the book
# Optional TrueType fonts; leave empty to search the system fonts
ANIM_FONT=
ANIM_FONT_BOLD=
ANIM_FONT_MONO=
